# ==========================================
# Application Configuration
# ==========================================
APP_NAME="Queue Management API"
APP_VERSION="2.1.0"
DEBUG=false
LOG_LEVEL=INFO

# ==========================================
# Database (PostgreSQL)
# ==========================================
DB_HOST=db
DB_PORT=5432
DB_NAME=queue_db
DB_USER=queue_user
DB_PASSWORD=replace_with_strong_db_password

# ==========================================
# Cache & Storage (Redis)
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_MAX_CONNECTIONS=50

# ==========================================
# Network & Security
# ==========================================
# Comma-separated list or JSON array of allowed origins
CORS_ORIGINS=https://your-frontend-domain.com,https://web.telegram.org
CORS_ALLOW_CREDENTIALS=true

# Port to expose application container on host (for docker-compose.yml)
APP_PORT=8000

# ==========================================
# Business Logic & Limits
# ==========================================
DEFAULT_MAX_POSITIONS=30
QUEUE_TTL_DAYS=14
SWAP_REQUEST_TTL_HOURS=24

# ==========================================
# Dev Tools (only used when running with --profile dev)
# ==========================================
REDIS_INSIGHT_PORT=5540
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=replace_with_strong_pgadmin_password
